{
  "name": "fungi-frontend",
  "version": "1.0.0",
  "description": "Этот каталог — чистая база для переписывания `frontend_fungi` с упором на: - предсказуемую архитектуру; - минимальный техдолг; - понятные правила для команды; - удобную поддержку и масштабирование.",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:components": "vitest run --dir src/shared/ui/primitives",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "e2e:headed": "playwright test --project=chromium --headed",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check": "npm run lint && npm run typecheck && npm run design:lint && npm run stories:check && npm run icons:check && npm run test && npm run build && npm run storybook:check",
    "format": "prettier --write .",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook --ci --url http://127.0.0.1:6006",
    "storybook:check": "start-server-and-test \"storybook dev -p 6006 --ci --quiet\" http://127.0.0.1:6006 \"npm run storybook:test\"",
    "lint:styles": "stylelint \"src/**/*.css\" --ignore-pattern \"src/shared/assets/styles/tokens.css\"",
    "lint:design": "node scripts/check-semantic-tokens.mjs",
    "design:lint": "npm run lint:styles && npm run lint:design",
    "scaffold:ui": "node scripts/scaffold-ui-component.mjs",
    "remove:ui": "node scripts/remove-ui-component.mjs",
    "ui:index:sync": "node scripts/sync-shared-ui-index.mjs",
    "icons:sync": "node scripts/sync-icons-index.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "stories:check": "node scripts/check-missing-stories.mjs",
    "stories:sync": "node scripts/check-missing-stories.mjs --write",
    "stories:coverage": "node scripts/generate-storybook-coverage.mjs",
    "stories:coverage:check": "node scripts/generate-storybook-coverage.mjs --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-vitest": "^10.3.4",
    "@storybook/react-vite": "^10.2.10",
    "@storybook/test-runner": "^0.24.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^2.1.3",
    "storybook": "^10.2.10",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
