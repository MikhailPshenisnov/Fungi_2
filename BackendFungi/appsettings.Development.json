{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FungiDbContext": "Host=localhost;Port=5531;Database=FungiDB;Username=CHANGE_ME;Password=CHANGE_ME"
  },
  "Jwt": {
    "Key": "CHANGE_ME_WITH_ENV_JWT_KEY_MIN_32_CHARS",
    "Issuer": "FungiBackend",
    "Audience": "FungiFrontend"
  },
  "Frontend": {
    "FrontendAddress": "http://localhost:5173",
    "AllowLocalhostOrigins": true,
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "DataInitialization": {
    "DefaultSuperUserRoleName": "Superuser",
    "DefaultCommonUserRoleName": "CommonUser",
    "DefaultSuperUserUsername": "CHANGE_ME_SUPERUSER",
    "DefaultSuperUserPassword": "CHANGE_ME_WITH_ENV_SUPERUSER_PASSWORD"
  },
  "AvatarStorage": {
    "PhysicalRoot": "Storage/avatars",
    "PublicBasePath": "/media/avatars",
    "MaxFileSizeBytes": 5242880,
    "MinImageSidePx": 128,
    "MaxImageSidePx": 4096,
    "MaxImageTotalPixels": 16000000,
    "OutputSizePx": 512,
    "WebpQuality": 80,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "ArticleMediaStorage": {
    "PhysicalRoot": "Storage/articles",
    "PublicBasePath": "/media/articles",
    "MaxFileSizeBytes": 8388608,
    "MinImageSidePx": 128,
    "MaxImageSidePx": 4096,
    "MaxImageTotalPixels": 20000000,
    "OutputMaxSidePx": 1600,
    "WebpQuality": 82,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "MushroomMediaStorage": {
    "PhysicalRoot": "Storage/mushrooms",
    "PublicBasePath": "/media/mushrooms",
    "MaxFileSizeBytes": 8388608,
    "MinImageSidePx": 128,
    "MaxImageSidePx": 4096,
    "MaxImageTotalPixels": 20000000,
    "OutputMaxSidePx": 1600,
    "WebpQuality": 82,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "SwaggerDocOptions": {
    "Name": "v1",
    "Version": "v1.0.0",
    "Title": "Fungi API",
    "Description": "API for Fungi project",
    "Servers": [
      {
        "Url": "http://localhost:5000",
        "Description": "Local Development"
      }
    ]
  }
}
