# Copy to .env for local development.
# Required for docker compose backend startup.

# Database container bootstrap credentials
DB_NAME=FungiDB
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_PORT=5531

# Backend connection string (must match DB_* values above)
DB_CONNECTION_STRING=Host=fungi-db;Port=5531;Database=FungiDB;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD

# Must be at least 32 chars.
JWT_KEY=CHANGE_ME_WITH_32_PLUS_CHARS_SECRET

# Bootstrap credentials for DataInitialization (if middleware is enabled).
DEFAULT_SUPERUSER_USERNAME=Superuser
DEFAULT_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
